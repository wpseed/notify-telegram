{
  "name": "wpseed/notify-telegram",
  "description": "Starter WordPress plugin for the Bedrock plugin lab: PSR-4 autoloading, shortcode, settings page, PHPUnit test suite against the WordPress test suite.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Wpseed\\NotifyTelegram\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wpseed\\NotifyTelegram\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "autoloader-suffix": "NotifyTelegram",
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "build": "@php bin/build",
    "test": "phpunit",
    "test:integration": "phpunit --testsuite integration",
    "test:unit": "phpunit --testsuite unit",
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
