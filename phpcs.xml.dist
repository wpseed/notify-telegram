<?xml version="1.0"?>
<ruleset name="Notify Telegram">
    <description>WordPress coding standards (WPCS 3) plus PHP 8.2+ compatibility checks.</description>

    <file>./notify-telegram.php</file>
    <file>./src</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="basepath" value="."/>

    <rule ref="WordPress">
        <!-- src/ follows PSR-4 (Plugin.php), not the WPCS class-plugin.php naming. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>

    <!--
        Guard against collisions with other plugins: everything declared in the global
        namespace (functions, constants, classes, hooks, options) must start with one of
        the prefixes below. The plugin's own code lives in the Wpseed\NotifyTelegram namespace.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="notify_telegram"/>
                <element value="NotifyTelegram"/>
                <element value="Wpseed\NotifyTelegram"/>
            </property>
        </properties>
    </rule>

    <config name="testVersion" value="8.2-"/>
    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="text_domain" value="notify-telegram"/>
</ruleset>
